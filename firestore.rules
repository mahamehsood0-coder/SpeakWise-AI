rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if true;
    }
    match /writing_history/{docId} {
      allow read, write: if true;
    }
    match /quiz_scores/{docId} {
      allow read, write: if true;
    }
    match /saved_words/{docId} {
      allow read, write: if true;
    }
  }
}
